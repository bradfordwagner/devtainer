#!/bin/sh
# XDG_RUNTIME_DIR is normally created by systemd/pam_systemd. Bare containers
# (e.g. a Coder pod) have neither, so it's unset — and sway then aborts with
# "XDG_RUNTIME_DIR is not set in the environment. Aborting.", making the RDP
# window open and instantly close. Provide a fallback only when it's missing so
# systemd hosts (WSL) keep their real /run/user/<uid>.
if [ -z "$XDG_RUNTIME_DIR" ]; then
  export XDG_RUNTIME_DIR=/tmp/xdg-runtime-$(id -u)
  mkdir -p "$XDG_RUNTIME_DIR"
  chmod 700 "$XDG_RUNTIME_DIR"
fi
exec sway
