# Ghostty Terminal Configuration
# https://ghostty.org/docs

# Font configuration
font-family = {{ ghostty_font_family | default("IosevkaTerm Nerd Font Mono") }}
font-size = {{ ghostty_font_size | default(14) }}
font-style = {{ ghostty_font_style | default("Heavy") }}

# Theme
theme = {{ ghostty_theme | default("TokyoNight Storm") }}
background = 000000

# shell setup
initial-command = /bin/zsh --login
command = /bin/zsh --login

macos-titlebar-style = hidden
confirm-close-surface = false

# Don't fork each surface into a systemd transient cgroup scope. The default
# (single-instance) needs a systemd user session over D-Bus; on systemd-less
# hosts (e.g. a bare Coder pod) that call fails and the surface dies on launch,
# so ghostty opens then instantly closes. Ignored on macOS; harmless on WSL.
linux-cgroup = never
