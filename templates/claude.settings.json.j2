{
  "model": "opus[1m]",
  "theme": "dark",
  "extraKnownMarketplaces": {
    "voicemode": {
      "source": {
        "source": "github",
        "repo": "mbailey/voicemode"
      }
    }
  },
  "enabledPlugins": {
    "voicemode@voicemode": true
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ ansible_facts.env.HOME }}/workspace/github/bradfordwagner/tmux/tmux.claude.notify/bin/claude-notify notify"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{ ansible_facts.env.HOME }}/.claude/hooks/bd-ready.sh"
          }
        ]
      }
    ]
  }
}
